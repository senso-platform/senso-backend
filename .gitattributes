# Normalise line endings: LF everywhere by default.
* text=auto eol=lf

# Windows batch scripts must keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files.
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary

# Maven wrapper properties and shell scripts must be LF.
.mvn/wrapper/maven-wrapper.properties text eol=lf
*.sh text eol=lf
