@startuml

title identity — Login (current implementation)

autonumber
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center

actor User
participant "Frontend" as FE
participant "AuthController" as Controller
participant "AuthenticationService" as Authentication
participant "UserRepository" as UserRepo
participant "PasswordService" as Password
participant "JwtService" as Jwt
participant "JwtKeyProvider" as Keys
participant "RefreshTokenService" as Refresh
participant "RefreshTokenRepository" as RefreshRepo
database "PostgreSQL\nidentity schema" as DB

User -> FE : email + password
FE -> Controller : POST /api/v1/auth/login\nLoginRequest
Controller -> Authentication : login(email, password, null)

Authentication -> UserRepo : findByEmail(email)
UserRepo -> DB : SELECT user + roles
DB --> UserRepo : User / empty
UserRepo --> Authentication : User / empty

alt user exists
    Authentication -> Password : matches(rawPassword, passwordHash)
    Password --> Authentication : true / false

    alt password valid and status == ACTIVE
        Authentication -> Jwt : createAccessToken(user)
        Jwt -> Keys : getPublicKey() / getPrivateKey()
        Keys --> Jwt : RSA keys
        Jwt --> Authentication : access JWT (15 min)

        Authentication -> Refresh : create(userId, userAgent)
        Refresh -> Refresh : generate 32 random bytes\nBase64URL + SHA-256 hash
        Refresh -> RefreshRepo : save(RefreshToken)
        RefreshRepo -> DB : INSERT refresh_tokens\nexpiresAt = now + 7 days
        DB --> RefreshRepo : saved
        RefreshRepo --> Refresh : RefreshToken
        Refresh --> Authentication : raw refresh token

        Authentication --> Controller : LoginResult(access, refresh)
        Controller -> Controller : build HttpOnly Secure\nSameSite=Strict cookie
        Controller --> FE : 200 OK\nLoginResponse + Set-Cookie
    else invalid password or inactive user
        Authentication --> Controller : IllegalStateException
        Controller --> FE : authentication error
    end
else user not found
    Authentication --> Controller : IllegalStateException
    Controller --> FE : authentication error
end

note right of Controller
Current controller passes userAgent = null.
Refresh token is returned only through
an HttpOnly cookie.
end note

@enduml
