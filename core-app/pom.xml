  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Contract-first: интерфейсы и модели из senso-api.v1.yaml. Сгенерированный код не правим (AGENTS.md §4).
        Пакет dev.senso.openapi намеренно вне dev.senso.core: контракт не принадлежит ни одному модулю Modulith,
        и любой модуль может реализовать свой интерфейс (AuthApi, DevicesApi…) без межмодульной зависимости.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-api</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../contracts/openapi/senso-api.v1.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>dev.senso.openapi.api</apiPackage>
              <modelPackage>dev.senso.openapi.model</modelPackage>
              <generateApis>true</generateApis>
              <generateModels>true</generateModels>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <configOptions>
                <!--
                  useSpringBoot3=true НЕ означает «мы на Boot 3». У openapi-generator 7.25 нет
                  отдельного флага для Boot 4; этот флаг включает стек Spring 6+ (jakarta.*),
                  который в Boot 4 не менялся. Проверено компиляцией с boot 4.1.1.
                  НЕ «исправлять» на useSpringBoot2/useSpringBoot4 — второго флага не существует,
                  а useSpringBoot2 вернёт javax.* и сломает сборку.
                -->
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useJakartaEe>true</useJakartaEe>
                <useTags>true</useTags>
                <skipDefaultInterface>true</skipDefaultInterface>
                <openApiNullable>false</openApiNullable>
                <documentationProvider>none</documentationProvider>
                <dateLibrary>java8</dateLibrary>
                <useBeanValidation>true</useBeanValidation>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
