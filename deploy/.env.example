# Скопировать в deploy/.env. Значения только для локальной разработки.

# PostgreSQL
SENSO_DB_NAME=senso
SENSO_DB_USER=senso
SENSO_DB_PASSWORD=senso-dev-pass
SENSO_DB_PORT=5432
# JDBC-URL приложения. Обязателен префикс "jdbc:" и порт = SENSO_DB_PORT.
# Без "jdbc:" старт падает: 'url' must start with "jdbc". Пустое значение тоже ломает старт — лучше вовсе
# не задавать SENSO_DB_URL: профиль local имеет такой же дефолт в application-local.yml.
# Канон в репозитории — 5432; менять его в трекаемых файлах не нужно, порты различаются между машинами.
# Если 5432 на хосте уже занят (своя Windows-служба PostgreSQL перекрывает опубликованный порт контейнера,
# а 127.0.0.1:5432 при этом отвечает не контейнеру), подними контейнер на свободном порту только в своём .env:
#   SENSO_DB_PORT=5433
# и скажи приложению про этот же порт через окружение запуска (docker compose этот файл не отдаёт JVM):
#   SENSO_DB_URL=jdbc:postgresql://localhost:5433/senso   # IDEA: Run/Debug Configs → Environment variables
SENSO_DB_URL=jdbc:postgresql://localhost:5432/senso

# RabbitMQ: порты на хосте
SENSO_RABBIT_AMQP_PORT=5672
SENSO_RABBIT_UI_PORT=15672
SENSO_MQTT_PORT=1883

# RabbitMQ: пользователи из deploy/rabbitmq/definitions.json.
# Пароли здесь должны совпадать с хэшами в definitions.json
# (пересчитать: python deploy/rabbitmq/hash_password.py <пароль>).
SENSO_RABBIT_ADMIN_USER=senso-admin
SENSO_RABBIT_ADMIN_PASSWORD=admin-dev-pass
SENSO_RABBIT_CORE_USER=senso-core
SENSO_RABBIT_CORE_PASSWORD=core-dev-pass
SENSO_RABBIT_INGEST_USER=senso-ingest
SENSO_RABBIT_INGEST_PASSWORD=ingest-dev-pass

# Эмулятор шлюза (MQTT): логин = gatewayId
SENSO_EMULATOR_GATEWAY_ID=gw-emulator-01
SENSO_EMULATOR_PASSWORD=emulator-dev-pass
